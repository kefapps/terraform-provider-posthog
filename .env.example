# Copy this file to `.env` and adjust the 1Password vault/item names.
#
# Recommended 1Password structure:
# - Vault: ansyo-dev
# - Item: posthog-terraform-provider
# - Fields:
#   - api_key
#   - project_id
#   - host
#   - organization_id
#   - test_user_email
#
# The provider and acceptance tests read these names directly from the process
# environment. `op run --env-file=.env -- <command>` resolves the secret
# references at runtime.

ONEPASSWORD_VAULT=ansyo-dev
ONEPASSWORD_ITEM=posthog-terraform-provider

POSTHOG_API_KEY=op://$ONEPASSWORD_VAULT/$ONEPASSWORD_ITEM/api_key
POSTHOG_PROJECT_ID=op://$ONEPASSWORD_VAULT/$ONEPASSWORD_ITEM/project_id
POSTHOG_HOST=op://$ONEPASSWORD_VAULT/$ONEPASSWORD_ITEM/host
POSTHOG_ORGANIZATION_ID=op://$ONEPASSWORD_VAULT/$ONEPASSWORD_ITEM/organization_id

# Optional. Only required by acceptance tests that exercise org membership flows.
POSTHOG_TEST_USER_EMAIL=op://$ONEPASSWORD_VAULT/$ONEPASSWORD_ITEM/test_user_email
